# Backend Environment Variables Template
# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/buildnear_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Hibernate / JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# JWT Security (Generate a 256-bit secret key in production)
APP_JWT_SECRET=9a7c3b1e8f2a4d6c5e7b9a0f1d2c3e4b5a6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e
APP_JWT_EXPIRATION_MS=86400000

# Allowed CORS Origins (Comma-separated in production, e.g., https://buildnear-frontend.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app
